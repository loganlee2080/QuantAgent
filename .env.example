# Copy to .env or .env.local and fill in. .env.local overrides .env (keep secrets there, add to .gitignore).

BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_FUTURES_BASE=https://fapi.binance.com

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-4-5

COINGLASS_API_KEY=your_coinglass_api_key

RUN_FETCH_LOOPS=true

# --- Optional: Intervals (seconds) ---
# CRAWL_POSITIONS_INTERVAL_SECONDS=60
# MARKET_DATA_INTERVAL_SECONDS=300
